# Copy to .env (git-ignored). Identifiers only here; never paste keys or tokens into this file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dk_publishing

# Google (used by the Sheet-sync slice)
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Path to the service-account JSON key, kept OUTSIDE this repo (it is a secret):
GOOGLE_APPLICATION_CREDENTIALS=

# Meta publishing app (used by the Instagram/Facebook/Threads adapters)
META_APP_ID=

# Meta: one credentials file for Facebook, Instagram and Threads (`make meta-init` creates it).
# Ids are not secrets; tokens live only in the file, which stays outside this repo.
META_CREDENTIALS_FILE=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
THREADS_USER_ID=
# Older alternative, Facebook only: a file holding just the Page token
# Path to a file holding the Page access token, kept OUTSIDE this repo (it is a secret):
FACEBOOK_PAGE_TOKEN_FILE=
# Where live platforms keep media downloaded from Drive (default: .media in the repo, git-ignored):
MEDIA_DIR=

# YouTube (only read when youtube is `live` in config/platforms.yaml): `make connect-youtube` creates it
YOUTUBE_CREDENTIALS_FILE=
