# Serves ONLY the temporary media links (Instagram and Threads fetch their files from here).
# Every link is an unguessable token folder that the app removes after use. There is no
# directory listing, and nothing else is reachable: the Dagster UI is not published at all.
{$MEDIA_SITE} {
	root * /srv/public
	handle /tiktok/callback {
		header Content-Type "text/plain; charset=utf-8"
		respond "TikTok sign-in finished. Copy the full address of this page (it contains code=...) and paste it into the terminal that is waiting for it. You can close this tab afterwards." 200
	}
	@file path_regexp ^/[A-Za-z0-9_-]{20,}/[^/]+$
	handle @file {
		header Cache-Control "no-store"
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
